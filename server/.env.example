# The static and server editions use separate artifacts. The image is published
# after the validated static FTP release completes successfully.
ALWIS_SERVER_IMAGE=ghcr.io/bastian-noel/alwis-server:latest
ALWIS_LOCAL_PORT=3100

# Public HTTPS URL configured on the reverse proxy.
PUBLIC_BASE_URL=https://alwis.example.org
# Leave empty for same-origin use. Separate origins must be exact HTTPS origins.
ALLOWED_ORIGINS=
# Enable only when the loopback port is reached through your trusted reverse proxy.
TRUST_PROXY=true
ALWIS_ADMIN_USER=admin

# Resource caps follow the 1 GiB total service budget in the collaboration spec.
ALWIS_MEMORY_LIMIT=640m
ALWIS_MEMORY_RESERVATION=256m
ALWIS_MEMORY_SWAP=640m
ALWIS_CPUS=0.75
