# Public URL of the studio. HTTPS, or HTTP localhost for local testing.
ALWIS_BASE_URL=https://alwis.example.org

# Required administrator password. No minimum length is enforced.
ALWIS_ADMIN_PASSWORD=

# Guest preview: static (default) or interactive (guest JS, host PHP/MariaDB).
ALWIS_PREVIEW_MODE=static

# Optional separate preview URL; a sibling subdomain is supported.
# Route it to the same container port, with its own DNS/TLS.
# Interactive mode without this URL requires explicit guest trust;
# project scripts then have access to the guest studio and local storage.
# Refusal keeps the static preview. Consent does not provide isolation.
ALWIS_PREVIEW_URL=

# true when a trusted reverse proxy terminates HTTPS in front of the container.
ALWIS_TRUST_PROXY=true
